{
  "id": "chin_up",
  "displayName": "Chin-up",
  "category": "upper",
  "loadType": "bodyweight",
  "requiredLandmarks": [11, 12, 13, 14, 15, 16],
  "visibleFraction": 0.67,
  "positiveLine": "Strong chin — chin clears with control",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "top", "enterWhen": { "metric": "elbow_angle_avg", "op": "<", "value": 70 } },
    { "name": "bottom", "enterWhen": { "metric": "elbow_angle_avg", "op": ">", "value": 158 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "elbow_angle_avg", "op": ">=", "value": 70 }, { "metric": "elbow_angle_avg", "op": "<=", "value": 158 } ] } }
  ],
  "rules": [
    {
      "id": "chin_up.full_lockout",
      "region": "arms",
      "penalty": 10,
      "when": { "metric": "elbow_angle_avg", "op": "<", "value": 155 },
      "feedback": "Fully extend at the bottom",
      "breakdown": { "label": "Bottom lockout", "format": "angle", "metric": "elbow_angle_avg", "region": "arms" }
    },
    {
      "id": "chin_up.top_range",
      "region": "arms",
      "penalty": 12,
      "when": { "metric": "elbow_angle_avg", "op": ">=", "value": 95 },
      "feedback": "Pull chin past the bar",
      "breakdown": { "label": "Top range", "format": "angle", "metric": "elbow_angle_avg", "region": "arms" }
    }
  ]
}
