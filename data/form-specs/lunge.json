{
  "id": "lunge",
  "displayName": "Lunge",
  "category": "lower",
  "loadType": "external",
  "requiredLandmarks": [11, 12, 23, 24, 25, 26, 27, 28],
  "visibleFraction": 0.75,
  "positiveLine": "Good lunge — depth and alignment on point",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "bottom", "enterWhen": { "metric": "knee_angle_min", "op": "<", "value": 95 } },
    { "name": "top", "enterWhen": { "metric": "knee_angle_min", "op": ">", "value": 150 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "knee_angle_min", "op": ">=", "value": 95 }, { "metric": "knee_angle_min", "op": "<=", "value": 150 } ] } }
  ],
  "rules": [
    {
      "id": "lunge.front_knee",
      "region": "legs",
      "penalty": 12,
      "loadRelax": { "perXBodyweight": 0.5, "addThresholdDeg": 6 },
      "when": { "any": [ { "metric": "knee_angle_min", "op": "<=", "value": 80 }, { "metric": "knee_angle_min", "op": ">=", "value": 100 } ] },
      "feedback": "Front knee over ankle, ~90°",
      "breakdown": { "label": "Front knee", "format": "angle", "metric": "knee_angle_min", "detail": "~90° over ankle", "region": "legs" }
    },
    {
      "id": "lunge.back_knee",
      "region": "legs",
      "penalty": 8,
      "when": { "metric": "knee_angle_max", "op": "<", "value": 140 },
      "feedback": "Lower back knee toward the floor",
      "breakdown": { "label": "Back knee", "format": "boolean", "okLabel": "Low", "failLabel": "Higher", "detail": "Back knee toward floor", "region": "legs" }
    }
  ]
}
