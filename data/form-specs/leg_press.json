{
  "id": "leg_press",
  "displayName": "Leg Press",
  "category": "lower",
  "loadType": "external",
  "requiredLandmarks": [23, 24, 25, 26, 27, 28],
  "visibleFraction": 0.67,
  "positiveLine": "Strong press — full depth and lockout",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "bottom", "enterWhen": { "metric": "knee_angle_avg", "op": "<", "value": 95 } },
    { "name": "top", "enterWhen": { "metric": "knee_angle_avg", "op": ">", "value": 162 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "knee_angle_avg", "op": ">=", "value": 95 }, { "metric": "knee_angle_avg", "op": "<=", "value": 162 } ] } }
  ],
  "rules": [
    {
      "id": "leg_press.depth",
      "region": "legs",
      "penalty": 12,
      "loadRelax": { "perXBodyweight": 1.5, "addThresholdDeg": 8 },
      "when": { "metric": "knee_angle_avg", "op": ">=", "value": 110 },
      "feedback": "Lower until knees reach ~90°",
      "breakdown": { "label": "Knee angle", "format": "angle", "metric": "knee_angle_avg", "region": "legs" }
    },
    {
      "id": "leg_press.symmetry",
      "region": "legs",
      "penalty": 8,
      "when": { "metric": "knee_symmetry_diff", "op": ">=", "value": 15 },
      "feedback": "Press evenly through both legs",
      "breakdown": { "label": "Symmetry", "format": "boolean", "okLabel": "Even", "failLabel": "Adjust", "region": "legs" }
    }
  ]
}
