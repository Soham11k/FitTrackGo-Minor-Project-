{
  "id": "cable_bicep_curl",
  "displayName": "Cable Bicep Curl",
  "category": "upper",
  "loadType": "external",
  "requiredLandmarks": [11, 12, 13, 14, 15, 16],
  "visibleFraction": 0.67,
  "positiveLine": "Constant tension — elbows fixed, smooth reps",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "bottom", "enterWhen": { "metric": "elbow_angle_avg", "op": "<", "value": 62 } },
    { "name": "top", "enterWhen": { "metric": "elbow_angle_avg", "op": ">", "value": 138 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "elbow_angle_avg", "op": ">=", "value": 62 }, { "metric": "elbow_angle_avg", "op": "<=", "value": 138 } ] } }
  ],
  "rules": [
    {
      "id": "cable_bicep_curl.full_range",
      "region": "arms",
      "penalty": 12,
      "when": { "any": [ { "metric": "elbow_angle_avg", "op": "<=", "value": 30 }, { "metric": "elbow_angle_avg", "op": ">=", "value": 160 } ] },
      "feedback": "Use full range — stack stays under control",
      "breakdown": { "label": "Elbow angle", "format": "angle", "metric": "elbow_angle_avg", "region": "arms" }
    }
  ]
}
