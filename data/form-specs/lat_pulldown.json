{
  "id": "lat_pulldown",
  "displayName": "Lat Pulldown",
  "category": "upper",
  "loadType": "external",
  "requiredLandmarks": [11, 12, 13, 14, 15, 16],
  "visibleFraction": 0.67,
  "positiveLine": "Smooth pulldown — full range and tight torso",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "bottom", "enterWhen": { "metric": "elbow_angle_avg", "op": "<", "value": 85 } },
    { "name": "top", "enterWhen": { "metric": "elbow_angle_avg", "op": ">", "value": 160 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "elbow_angle_avg", "op": ">=", "value": 85 }, { "metric": "elbow_angle_avg", "op": "<=", "value": 160 } ] } }
  ],
  "rules": [
    {
      "id": "lat_pulldown.range",
      "region": "arms",
      "penalty": 12,
      "when": { "metric": "elbow_angle_avg", "op": ">=", "value": 115 },
      "feedback": "Pull the bar to your upper chest",
      "breakdown": { "label": "Elbow angle", "format": "angle", "metric": "elbow_angle_avg", "detail": "Bar to upper chest", "region": "arms" }
    },
    {
      "id": "lat_pulldown.symmetry",
      "region": "arms",
      "penalty": 8,
      "when": { "metric": "elbow_symmetry_diff", "op": ">=", "value": 18 },
      "feedback": "Pull evenly with both sides",
      "breakdown": { "label": "Symmetry", "format": "boolean", "okLabel": "Even", "failLabel": "Adjust", "region": "arms" }
    }
  ]
}
