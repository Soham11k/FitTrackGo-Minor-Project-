{
  "id": "incline_bench_press",
  "displayName": "Incline Bench Press",
  "category": "upper",
  "loadType": "external",
  "requiredLandmarks": [11, 12, 13, 14, 15, 16],
  "visibleFraction": 0.67,
  "positiveLine": "Solid press — keep the bar over the upper chest",
  "repPattern": "top_bottom_top",
  "phases": [
    { "name": "bottom", "enterWhen": { "metric": "elbow_angle_avg", "op": "<", "value": 95 } },
    { "name": "top", "enterWhen": { "metric": "elbow_angle_avg", "op": ">", "value": 160 } },
    { "name": "concentric", "enterWhen": { "all": [ { "metric": "elbow_angle_avg", "op": ">=", "value": 95 }, { "metric": "elbow_angle_avg", "op": "<=", "value": 160 } ] } }
  ],
  "rules": [
    {
      "id": "incline_bench_press.depth",
      "region": "arms",
      "penalty": 12,
      "loadRelax": { "perXBodyweight": 1.0, "addThresholdDeg": 6 },
      "when": { "metric": "elbow_angle_avg", "op": ">=", "value": 110 },
      "feedback": "Lower under control to the upper chest",
      "breakdown": { "label": "Elbow angle", "format": "angle", "metric": "elbow_angle_avg", "detail": "~90° at the chest", "region": "arms" }
    },
    {
      "id": "incline_bench_press.symmetry",
      "region": "arms",
      "penalty": 10,
      "when": { "metric": "elbow_symmetry_diff", "op": ">=", "value": 18 },
      "feedback": "Press evenly — keep the bar level",
      "breakdown": { "label": "Symmetry", "format": "boolean", "okLabel": "Even", "failLabel": "Adjust", "region": "arms" }
    }
  ]
}
