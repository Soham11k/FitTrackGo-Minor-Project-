{
  "name": "fit-track-go-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "dev:lan": "node scripts/print-lan-ip.mjs && next dev -H 0.0.0.0",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:android": "node scripts/sync-android-launcher-icons.mjs",
    "brand:all": "npm run brand:assets && npm run brand:android",
    "validate-env": "node scripts/validate-env.mjs",
    "diag:supabase-env": "node scripts/diag-supabase-env.mjs",
    "check:supabase-host": "node scripts/check-supabase-host.mjs",
    "db:apply-wearables": "node scripts/apply-wearable-migration.mjs",
    "db:push": "node scripts/migrate.mjs",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:reset": "node scripts/migrate.mjs --reset",
    "db:seed": "node scripts/migrate.mjs --seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "lh:audit": "node scripts/lighthouse-audit.mjs",
    "ci:check": "npm run validate-env && npm run lint:ci && npm run typecheck && npm run test && npm run build && node scripts/bundle-guard.mjs && node scripts/extract-i18n-keys.mjs && npm run lh:audit",
    "synthetic-checks": "node scripts/synthetic-checks.mjs",
    "build:android": "node scripts/prepare-android-build.mjs && BUILD_FOR_ANDROID=1 npm run build && node scripts/restore-after-android-build.mjs",
    "cap:sync": "npx cap sync android",
    "android": "npm run brand:android && npm run build:android && npx cap sync android && npx cap open android",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "env:vercel": "node scripts/push-vercel-env.mjs",
    "deploy:vercel": "node scripts/deploy-vercel.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@mediapipe/tasks-vision": "^0.10.34",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.105.3",
    "@types/leaflet": "^1.9.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.38.0",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.564.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "docx": "^9.6.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.4",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.7.0",
    "pg": "^8.14.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}
