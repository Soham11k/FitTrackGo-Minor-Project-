# Supabase — required for auth and persisted data
# Get these from https://app.supabase.com → Your project → Settings → API
# Project URL must be the API host: https://<project-ref>.supabase.co (copy from the dashboard; do not use a deleted or paused project’s URL).
NEXT_PUBLIC_SUPABASE_URL=https://ffuxuhhjxnuivyznmbtb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdXh1aGhqeG51aXZ5em5tYnRiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwODg5OTEsImV4cCI6MjA5MzY2NDk5MX0.k7StGKHuFvHAHe9seWfM0WwTH9XuFGTxW98Z6lG79EE

# Preferred for `npm run db:push`: Session mode URI from Supabase → Settings → Database (not the “direct” db.* host if you hit IPv6/timeouts).
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# If you omit SUPABASE_DB_URL: database password only (not a full URI). Script builds pooler URLs from NEXT_PUBLIC_SUPABASE_URL + this.
# SUPABASE_DB_PASSWORD=

# Optional: try this AWS region first when auto-building pooler URLs (must match your project region).
# SUPABASE_POOLER_REGION=ap-south-1

# Optional — only needed for server routes that use admin actions
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZmdXh1aGhqeG51aXZ5em5tYnRiIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODA4ODk5MSwiZXhwIjoyMDkzNjY0OTkxfQ.4Na6V9qs2cwTJX-e4wDdyRTTyVLtv8ktOLMReC4uGbA

# Optional — Fitbit integration (wearables)
# Create an app at https://dev.fitbit.com/apps/new
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# FITBIT_REDIRECT_URI=http://localhost:3000/api/wearables/fitbit/callback

# Optional — Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional — Vercel Cron / scheduled jobs (app/api/cron/reminders)
# Generate a long random string; set the same in your scheduler (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Optional — internal push admin (app/api/push/send); must match X-Cron-Secret header
PUSH_ADMIN_TOKEN=

# Web Push (VAPID) — for push subscribe + send; public key is safe in the client
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: URL for VAPID "contact"
VAPID_SUBJECT=mailto:you@example.com

# Optional — AI coach (RAG + OpenAI) on /api/ai-coach/chat; server-side only
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional — distributed rate limiting (production, multi-region)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — Arena duels: set to 1 to always use device-only duels (skip Supabase form_duels when paused / no credits)
# NEXT_PUBLIC_ARENA_DUELS_LOCAL_ONLY=1
