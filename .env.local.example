# Supabase — required for auth and persisted data
# Get these from https://app.supabase.com → Your project → Settings → API
# Project URL must be the API host: https://<project-ref>.supabase.co (copy from the dashboard; do not use a deleted or paused project’s URL).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Client-side encryption (default ON). Set =0 to disable and store profile name + run paths in plaintext again.
# NEXT_PUBLIC_ENABLE_USER_DATA_ENCRYPTION=0
# Coach clip uploads: NEXT_PUBLIC_ENABLE_CLIP_ENCRYPTION=0 disables AES-GCM clip blobs (see lib/coach-clips-supabase.ts).

# Dev: browser calls Supabase directly by default. Set to 1 only if ad-block blocks *.supabase.co.
# NEXT_PUBLIC_SUPABASE_USE_DEV_PROXY=1
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Auth: browse at localhost (not http://0.0.0.0:…) so magic-link cookies match. In Supabase → Authentication → Redirect URLs include:
#   http://localhost:3000/auth/callback
#
# Preferred for `npm run db:push`: Session mode URI from Supabase → Settings → Database (not the “direct” db.* host if you hit IPv6/timeouts).
# SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# If you omit SUPABASE_DB_URL: database password only (not a full URI). Script builds pooler URLs from NEXT_PUBLIC_SUPABASE_URL + this.
# SUPABASE_DB_PASSWORD=

# Optional: try this AWS region first when auto-building pooler URLs (must match your project region).
# SUPABASE_POOLER_REGION=ap-south-1

# Optional — only needed for server routes that use admin actions
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional — Fitbit integration (wearables)
# Create an app at https://dev.fitbit.com/apps/new
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
# FITBIT_REDIRECT_URI=http://localhost:3000/api/wearables/fitbit/callback

# Optional — Google Fit / Fitness API (Wear OS & Android)
# 1) Google Cloud Console → APIs & Services → enable "Fitness API".
# 2) OAuth consent screen → add scopes: fitness.activity.read, fitness.heart_rate.read,
#    fitness.oxygen_saturation.read, fitness.sleep.read (full URLs match lib/wearables/providers/google-fit.ts).
# 3) Credentials → OAuth 2.0 Client ID → Web application → Authorized redirect URIs must include exactly:
#    http://localhost:3000/api/wearables/google_fit/callback   (local)
#    https://YOUR_DOMAIN/api/wearables/google_fit/callback      (production)
# 4) Set NEXT_PUBLIC_APP_URL to that same origin (e.g. http://localhost:3000 or https://YOUR_DOMAIN)
#    so the server builds the same redirect_uri Google expects.
#    If you use `next dev -H 0.0.0.0`, OAuth still uses http://localhost:3000/<callback> internally — register that localhost URI with Google/Fitbit.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production on Vercel Team projects use https://<project>-<team-slug>.vercel.app — copy from Vercel → Project → Domains (no trailing slash).
# Example: NEXT_PUBLIC_APP_URL=https://fit-track-go-app-sohamkaul366-9954s-projects.vercel.app
# Push Supabase + wearable OAuth vars to Vercel Production: npm run env:vercel
# (script skips NEXT_PUBLIC_APP_URL if it is still localhost — add the HTTPS URL in Vercel Dashboard.)
# Wearables checklist (names + callbacks): config/vercel-wearables.env.example

# Optional — Sentry error monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional — Vercel Cron / scheduled jobs (app/api/cron/reminders)
# Generate a long random string; set the same in your scheduler (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Optional — internal push admin (app/api/push/send); must match X-Cron-Secret header
PUSH_ADMIN_TOKEN=

# Web Push (VAPID) — for push subscribe + send; public key is safe in the client
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: URL for VAPID "contact"
VAPID_SUBJECT=mailto:you@example.com

# Optional — AI coach (RAG + OpenAI) on /api/ai-coach/chat; server-side only
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Optional — distributed rate limiting (production, multi-region)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional — Arena duels: set to 1 to always use device-only duels (skip Supabase form_duels when paused / no credits)
# NEXT_PUBLIC_ARENA_DUELS_LOCAL_ONLY=1

# Optional — coach clip uploads to Supabase Storage (private bucket coach-clips)
# NEXT_PUBLIC_ENABLE_COACH_CLIPS=1

# Optional — encrypt coach clips client-side before upload (default on in dev builds;
# set to 0 only for debugging plaintext uploads locally).
# NEXT_PUBLIC_ENABLE_CLIP_ENCRYPTION=0

# Optional — spec-driven form engine. When 1, exercises with a matching JSON
# spec under data/form-specs/ are scored by the generic engine instead of
# the legacy hand-coded branches. Default off until we have parity fixtures
# for the migrated exercises.
# NEXT_PUBLIC_ENABLE_FORM_ENGINE=1

# Optional — AI fallback scorer for exercises that have no FormSpec. The
# client posts a frame summary to /api/ai-coach/score-pose. Requires
# OPENAI_API_KEY to be set on the server.
# NEXT_PUBLIC_ENABLE_AI_FALLBACK=1

# Optional — post-set AI clip review. Surfaces the "Get AI review" CTA in
# the replay sheet. Requires OPENAI_API_KEY and coach clip cloud sync to
# be enabled so the WebM is accessible.
# NEXT_PUBLIC_ENABLE_CLIP_REVIEW=1
